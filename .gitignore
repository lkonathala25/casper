__pycache__/
*.pyc

# Generated constraint files. Regenerated in under a second by the task
# generators (see tasks/*/ and examples/generate_*.py), so they are derived
# artifacts rather than source. The N=1024 sum tree alone is 53 MB.
constraints/mnist/mnist_add_n*.txt
constraints/mnist/mnist_sum_digit_tree_n*.txt

# Baseline run outputs (logs, checkpoints, generated configs)
baselines/*/logs/
baselines/*/model/
baselines/*/**/_cfg_*.yaml

# Warcraft dataset (~4.7 GB). Provenance and regeneration in data/warcraft/MANIFEST.md
data/warcraft/
!data/warcraft/MANIFEST.md
