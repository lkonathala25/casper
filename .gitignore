__pycache__/
*.pyc

# Datasets are downloaded or generated by the user (see README), never committed.
data/

# Run outputs (tools/runlib.sh writes under runs/ by default).
runs/

# Generated MNIST constraint files, rebuilt by tasks/mnist/train.py on first use.
constraints/mnist/

# 30x30 steps artifacts (600+ MB). Rebuild with
# tasks/warcraft/build_steps_artifacts.py --size 30 and
# tasks/warcraft/compile_steps_encoding.py (see README).
constraints/warcraft/steps_artifacts/steps_30_trimmed.txt
constraints/warcraft/steps_artifacts/steps_30_trimmed_compiled.json
constraints/warcraft/steps_artifacts/steps_30_trimmed_compiled.stream.txt

# Visual Sudoku run outputs and caches.
tasks/sudoku/visual/checkpoint/
tasks/sudoku/visual/results/
**/llm_cache/
**/unsloth_compiled_cache/

# Compile logs written by tasks/warcraft/compile_steps_encoding.py.
logs/
